datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  entraId      String?       @unique
  email        String        @unique
  name         String
  role         String        @default("CANDIDATE")
  passwordHash String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  createdExams Exam[]        @relation("ExamCreator")
  attempts     ExamAttempt[]
  auditLogs    AuditLog[]
  examAccess   StudentExamAccess[]
  roomSessions RoomSession[]

  @@map("users")
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  questions   Question[]

  @@map("categories")
}

model Tag {
  id        String            @id @default(uuid())
  name      String            @unique
  questions QuestionOnTag[]

  @@map("tags")
}

model Question {
  id             String          @id @default(uuid())
  title          String
  code           String          @unique
  type           String
  difficulty     String          @default("INTERMEDIATE")
  points         Float           @default(1.0)
  negativePoints Float           @default(0.0)
  explanation    String?
  content        String          // JSON string holding options, drag/drop pairs, code templates, etc.
  version        Int             @default(1)
  isApproved     Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id])

  tags           QuestionOnTag[]
  sectionQuestions SectionQuestion[]
  caseStudyId    String?
  caseStudy      CaseStudy?      @relation(fields: [caseStudyId], references: [id])
  simulationId   String?
  simulation     Simulation?     @relation(fields: [simulationId], references: [id])
  labId          String?
  lab            Lab?            @relation(fields: [labId], references: [id])

  @@map("questions")
}

model QuestionOnTag {
  questionId String
  tagId      String

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@map("questions_on_tags")
}

model CaseStudy {
  id                   String     @id @default(uuid())
  title                String
  overview             String
  businessRequirements String
  technicalRequirements String
  existingEnvironment  String
  questions            Question[]

  @@map("case_studies")
}

model Simulation {
  id           String     @id @default(uuid())
  title        String
  portalType   String     // "AZURE_PORTAL" | "M365" | "CISCO_CLI"
  instructions String
  initialState String     // JSON representation of mock state
  targetState  String     // JSON validation criteria
  questions    Question[]

  @@map("simulations")
}

model Lab {
  id           String     @id @default(uuid())
  title        String
  scenario     String
  checklists   String     // JSON array of task items
  validation   String     // JSON execution scripts or state checks
  questions    Question[]

  @@map("labs")
}

model Exam {
  id                 String      @id @default(uuid())
  title              String
  code               String      @unique
  vendor             String      @default("MICROSOFT")
  examType           String      @default("CERTIFICATION")
  description        String?
  instructions       String?
  timeLimitMinutes   Int         @default(120)
  passingScore       Float       @default(70.0)
  totalQuestionsConfig Int       @default(50) // Configurable item count: 50, 70, 90, etc.
  isRandomized       Boolean     @default(true)
  shuffleAnswers     Boolean     @default(true)
  allowCalculator    Boolean     @default(true)
  allowNotes         Boolean     @default(true)
  negativeMarking    Boolean     @default(false)
  partialMarking     Boolean     @default(true)
  isGloballyUnlocked Boolean     @default(false)
  status             String      @default("PUBLISHED")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  creatorId          String
  creator            User        @relation("ExamCreator", fields: [creatorId], references: [id])

  sections           ExamSection[]
  attempts           ExamAttempt[]
  studentAccess      StudentExamAccess[]
  rooms              ExamRoom[]

  @@map("exams")
}

model ExamRoom {
  id          String        @id @default(uuid())
  roomCode    String        @unique
  title       String
  examId      String
  status      String        @default("OPEN") // "OPEN" | "CLOSED"
  allowReview Boolean       @default(true)
  createdBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  exam         Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  roomSessions RoomSession[]
  attempts     ExamAttempt[]

  @@map("exam_rooms")
}

model RoomSession {
  id       String   @id @default(uuid())
  roomId   String
  userId   String
  joinedAt DateTime @default(now())

  room ExamRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@map("room_sessions")
}

model StudentExamAccess {
  id         String   @id @default(uuid())
  userId     String
  examId     String
  isUnlocked Boolean  @default(false)
  unlockedAt DateTime @default(now())
  unlockedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId])
  @@map("student_exam_access")
}

model ExamSection {
  id               String            @id @default(uuid())
  examId           String
  title            String
  instructions     String?
  orderIndex       Int               @default(1)
  weightPercentage Float             @default(25.0) // Objective Domain weight e.g. 25.0%

  exam             Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions        SectionQuestion[]

  @@map("exam_sections")
}

model SectionQuestion {
  sectionId  String
  questionId String
  orderIndex Int

  section    ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([sectionId, questionId])
  @@map("section_questions")
}

model ExamAttempt {
  id               String        @id @default(uuid())
  userId           String
  candidateName    String?       // Candidate Full Name entered during Exam Room Join
  examId           String
  roomId           String?
  status           String        @default("IN_PROGRESS")
  startedAt        DateTime      @default(now())
  completedAt      DateTime?
  timeSpentSeconds Int           @default(0)
  totalQuestions   Int           @default(0)
  correctAnswers   Int           @default(0)
  scorePercentage  Float         @default(0.0)
  passed           Boolean       @default(false)
  answers          String        // JSON object mapping questionId to submitted answers & review flags
  sectionScores    String?       // JSON array of normalized section score breakdown for MS Score Report
  auditLogs        String?       // JSON array of event logs (e.g. tab switch, pause, resume)

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam             Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  room             ExamRoom?     @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@map("exam_attempts")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  ipAddress String?
  userId    String?
  timestamp DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
